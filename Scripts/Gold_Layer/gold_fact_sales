#TRANSFORMATION LOGIC FOR FACT TABLES

query = """
SELECT
    sd.order_number,
    pr.product_key,
    cu.customer_sk,
    sd.order_date,
    sd.ship_date,
    sd.due_date,
    sd.sales_amount,
    sd.quantity,
    sd.price
FROM workspace.silver_layer.Sales_details sd
LEFT JOIN workspace.gold_layer.dim_product pr
    ON sd.product_number = pr.product_number
LEFT JOIN workspace.gold_layer.dim_customers cu
    ON sd.customer_id = cu.customer_id;
"""
df = spark.sql(query)


#WRITE TO GOLD LAYER
df.write.mode("overwrite").format("delta").saveAsTable("workspace.gold_layer.fact_sales")
